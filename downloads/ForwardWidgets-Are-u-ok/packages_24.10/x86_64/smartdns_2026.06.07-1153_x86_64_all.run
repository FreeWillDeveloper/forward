    --confirm)
	verbose=y
	shift
	;;
	--noexec)
	script=""
    cleanup_script=""
    preextract=""
	shift
	;;
    --noexec-cleanup)
    cleanup_script=""
    shift
    ;;
    --keep)
	keep=y
	shift
	;;
    --target)
	keep=y
	targetdir="${2:-.}"
    shift 2 || { MS_Help; exit 1; }
